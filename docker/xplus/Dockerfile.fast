# Compilación rápida: el código nuevo y los assets encima de la última imagen publicada.
# Las gems ya vienen instaladas en la base (Gemfile.lock no cambió: `bundle check` lo verifica),
# así se evita compilar grpc/protobuf, que en Windows puede tumbar la VM de Docker Desktop.
# Uso: docker/xplus/build-fast.sh  (ver docs/xplus/DESARROLLO.md)
ARG BASE=ghcr.io/fabianbarua/chatwoot:v4.18.0-xp
FROM ${BASE}

ARG PNPM_VERSION="10.2.0"
ENV NODE_OPTIONS="--max-old-space-size=4096 --openssl-legacy-provider"
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
  && npm install -g pnpm@${PNPM_VERSION}

WORKDIR /app
# Dockerfile.fast.dockerignore deja fuera .git y spec: el commit llega como argumento.
COPY . /app

ARG GIT_SHA
# Store temporal vía entorno (assets:precompile corre su propio `pnpm install`) y CI=true para
# que pnpm no pregunte nada: sin TTY la pregunta deja la build colgada.
RUN export CI=true npm_config_store_dir=/tmp/pnpm-store \
  && bundle check \
  && echo "${GIT_SHA}" > /app/.git_sha \
  && mkdir -p /app/log \
  && pnpm i --frozen-lockfile \
  && SECRET_KEY_BASE=precompile_placeholder RAILS_LOG_TO_STDOUT=enabled bundle exec rake assets:precompile \
  && rm -rf node_modules tmp/cache /tmp/pnpm-store /root/.cache /root/.local/share/pnpm/store
