    {
      "id": "e063d386-6816-4b9f-9cd5-3a4b71d19660",
      "name": "Decidir respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Decide la respuesta del bot con los menús de la tabla \"Menú Xplus\".\n// No hace falta tocar este código: los menús se editan en la tabla y los textos en \"Configuración\".\nconst cfg = $('Configuración').first().json;\nconst conversacion = $('Mensaje de Chatwoot').first().json.body.conversation;\n\nconst normalizar = valor =>\n  String(valor ?? '')\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[*_~]/g, '')\n    .trim()\n    .toLowerCase();\nconst conSaltos = valor => String(valor ?? '').replace(/\\\\n/g, '\\n');\n\n// Menús armados con las filas de la tabla\nconst menus = {};\nfor (const { json: fila } of $input.all()) {\n  const clave = normalizar(fila.menu);\n  if (!clave) continue;\n  const menu = (menus[clave] ??= { titulo: '', opciones: {} });\n  if (normalizar(fila.accion) === 'titulo') menu.titulo = conSaltos(fila.texto);\n  else menu.opciones[String(fila.opcion ?? '').trim()] = fila;\n}\n\nconst mostrarMenu = clave => {\n  const menu = menus[clave];\n  const numeros = Object.keys(menu.opciones).sort((a, b) => Number(a) - Number(b));\n  const lineas = numeros.filter(n => n !== '0').map(n => ` [ ${n} ] - ${menu.opciones[n].texto}`);\n  if (clave !== 'inicio') lineas.push(` [ 0 ] - ${menu.opciones['0']?.texto || 'Voltar'}`);\n  return `${menu.titulo}\\n\\n${lineas.join('\\n')}\\n\\n${cfg.rodape}`;\n};\n\nconst respuesta = (accion, mensaje, menuSiguiente = '', intentos = 0, equipoId = '') => [\n  { json: { accion, mensaje, menu_siguiente: menuSiguiente, intentos, equipo_id: String(equipoId ?? '').trim() } },\n];\n\nconst atributos = conversacion.custom_attributes || {};\nconst menuActual = menus[atributos.menu_actual] ? atributos.menu_actual : '';\nconst intentos = Number(atributos.menu_intentos || 0);\nconst texto = normalizar($('Mensaje de Chatwoot').first().json.body.content);\nconst numero = (texto.match(/^\\[?\\s*(\\d{1,2})\\s*\\]?[.)\\-\\s]*$/) || [])[1];\n\nif (texto === 'encerrar' || texto === 'finalizar') return respuesta('cerrar', cfg.texto_encerrar);\nif (!menuActual || texto === 'menu') return respuesta('menu', mostrarMenu('inicio'), 'inicio');\n\nlet opcion = menus[menuActual].opciones[numero];\nif (!opcion && numero === '0' && menuActual !== 'inicio') opcion = { accion: 'menu', abre_menu: 'inicio' };\nconst accion = normalizar(opcion?.accion);\nconst destino = normalizar(opcion?.abre_menu);\n\nif (accion === 'menu' && menus[destino]) return respuesta('menu', mostrarMenu(destino), destino);\nif (accion === 'equipo') return respuesta('equipo', opcion.mensaje || cfg.texto_transferindo, '', 0, opcion.equipo_id);\nif (accion === 'cerrar') return respuesta('cerrar', opcion.mensaje || cfg.texto_encerrar);\n\n// Opción inválida: repite el menú y, a la N-ésima vez, pasa a un agente\nif (intentos + 1 >= Number(cfg.max_invalidas)) {\n  return respuesta('equipo', cfg.texto_transferindo, '', 0, cfg.equipo_fallback);\n}\nreturn respuesta('menu', `${cfg.texto_invalida}\\n\\n${mostrarMenu(menuActual)}`, menuActual, intentos + 1);\n"
      }
    },
    {
      "id": "0b87fd20-e635-47ad-9664-6588f3bf6772",
      "name": "Enviar mensaje al cliente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        960,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuración').item.json.chatwoot_url }}/api/v1/accounts/{{ $('Mensaje de Chatwoot').item.json.body.account.id }}/conversations/{{ $('Mensaje de Chatwoot').item.json.body.conversation.id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $('Decidir respuesta').item.json.mensaje, message_type: 'outgoing', private: false }) }}",
        "options": {
          "timeout": 15000
        }
      }
    },
